# Comma-separated valid API keys (default if unset: dev-key)
APP_API_KEYS=dev-key

# Or a single key used by CLI / MCP process
APP_API_KEY=dev-key

# Optional bearer alias for CLI/MCP
# APP_TOKEN=

# API port
# PORT=8787

# Shared JSON task store (API + CLI + MCP see the same data when set)
# TASKS_STORE_PATH=.data/tasks.json
