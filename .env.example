# Comma-separated accepted API keys. Outside production, `dev-key` is accepted
# when this is unset — callers must still send a key, there is no anonymous path.
APP_API_KEYS=dev-key

# Or a single key used by CLI / MCP process
APP_API_KEY=dev-key

# Optional bearer alias for CLI/MCP
# APP_TOKEN=

# API port
# PORT=8787

# Shared JSON stores (API + CLI + MCP see the same data when set).
# Relative paths resolve against the directory the command was launched from.
# TASKS_STORE_PATH=.data/tasks.json
# NOTES_STORE_PATH=.data/notes.json
# Scaffolded products: <SLUG>_STORE_PATH (e.g. ORDER_ITEMS_STORE_PATH)

