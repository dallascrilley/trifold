{
  "name": "cli-mcp-projects",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "dev:api": "pnpm --filter @app/api dev",
    "dev:cli": "pnpm --filter @app/cli start",
    "dev:mcp": "pnpm --filter @app/mcp start",
    "dev:mcp:http": "pnpm --filter @app/mcp start -- --http",
    "snapshot:update": "pnpm --filter @cli-mcp/openapi snapshot && pnpm --filter @cli-mcp/adapters-mcp snapshot",
    "scaffold": "tsx scripts/scaffold-product.ts",
    "openapi:import": "tsx scripts/openapi-import.ts"
  },
  "devDependencies": {
    "@cli-mcp/openapi": "workspace:*",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
